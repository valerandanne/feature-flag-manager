{
  "name": "feature-flag-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node ./dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "pretest": "npx prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "4.16.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "prisma": "4.16.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.2.2",
    "ts-node": "10.9.1",
    "jest": "29.6.1",
    "ts-jest": "29.1.0",
    "@types/jest": "29.5.3",
    "supertest": "6.3.3",
    "@types/supertest": "2.0.12",
    "@types/express": "4.17.21",
    "@types/body-parser": "1.19.3",
    "@types/cors": "2.8.17",
    "@types/node": "20.5.1"
  }
}
