generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id        String       @id @default(uuid())
  key       String       @unique
  name      String
  createdAt DateTime     @default(now())
  flags     FeatureFlag[]
  apiKeys   ApiKey[]
}

model FeatureFlag {
  id         String    @id @default(uuid())
  project    Project   @relation(fields: [projectId], references: [id])
  projectId  String
  name       String
  description String?
  archived   Boolean   @default(false)
  envConfigs FlagEnv[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, name])
}

model Environment {
  id   String @id @default(uuid())
  name String @unique
  flagEnvs FlagEnv[]
}

model FlagEnv {
  id        String      @id @default(uuid())
  flag      FeatureFlag @relation(fields: [flagId], references: [id])
  flagId    String
  env       Environment @relation(fields: [envId], references: [id])
  envId     String
  enabled   Boolean     @default(false)
  rollout   Int         @default(100)
  version   Int         @default(1)
  updatedAt DateTime    @updatedAt

  @@unique([flagId, envId])
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  description String?
  createdAt DateTime @default(now())
}
