# Node modules (root and any package)
node_modules/
**/node_modules/

# Build output (common patterns)
dist/
build/
out/
lib/
**/dist/
**/build/
**/out/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Jest cache
jest-cache/

# Caches
.cache/
.parcel-cache/
.eslintcache

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Misc
.vercel/
.next/
.turbo/

# Prisma env (if you keep secrets locally)
**/prisma/.env

# Lockfiles sometimes ignored if you want per-package control – keep if monorepo uses root package manager
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
